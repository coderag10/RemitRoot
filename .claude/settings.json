
{
  "permissions": {
    "allow": [
      "Bash(anchor build:*)",
      "Bash(anchor test:*)",
      "Bash(anchor keys:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(yarn:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(solana config get:*)",
      "Bash(solana balance:*)",
      "Bash(solana address:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(solana config set --url mainnet-beta:*)",
      "Bash(solana config set -u m:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf /:*)",
      "Read(~/.config/solana/id.json)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}